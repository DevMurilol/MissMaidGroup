{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "miss-maid-group",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by the cache layer. Must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "miss-maid-group"
    }
  ],
  "kv_namespaces": [
    // Create both with:
    //   npx wrangler kv namespace create NEXT_INC_CACHE_KV
    //   npx wrangler kv namespace create NEXT_TAG_CACHE_KV
    // then paste the returned ids here.
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "PASTE_INCREMENTAL_CACHE_KV_ID"
    },
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "PASTE_TAG_CACHE_KV_ID"
    }
  ]
}
