# Resend (https://resend.com) API key. Sends the internal lead email to
# hello@missmaidgroup.com.au and the confirmation to the customer.
#
# Local dev (`npm run dev`)      reads this file as .env
# Local Worker (`npm run preview`) reads .dev.vars instead (the Worker runtime
#                                 does not read .env)
# Production                      npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
