# Postgres connection string (Supabase, Neon, etc.).
# Supabase: Dashboard > Connect > "Transaction pooler" (port 6543). Used at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Direct (non transaction-pooled) connection, used only by `prisma migrate` / `prisma db`.
# Supabase: Dashboard > Connect > "Session pooler" (port 5432, IPv4 friendly).
# Optional: if unset, migrations fall back to DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Resend (https://resend.com) API key used to send quote emails.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Admin panel credentials (/admin).
ADMIN_EMAIL="admin@missmaidgroup.com.au"
ADMIN_PASSWORD="change-me"
# Random secret used to sign admin session cookies. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-too"

# Set to "true" to force-show the Airbnb Cleaning service when no database is connected.
SHOW_AIRBNB_SERVICE="false"
